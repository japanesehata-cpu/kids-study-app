# scripts/generate-word-images.mjs and scripts/generate-character-portraits.mjs
# generate images via the Gemini API. Copy this file to .env and fill in your key:
#
# GEMINI_API_KEY=your-key-here
#
# Optional overrides (defaults shown):
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# GEMINI_CHARACTER_MODEL=gemini-3.1-flash-image
# GEMINI_COOLDOWN_MS=2000

# scripts/generate-tts-cache.mjs needs a locally-running VOICEVOX engine
# (https://voicevox.hiroshiba.jp/) — no key required, nothing here is required.
#
# Optional override (default shown):
# TTS_CACHE_COOLDOWN_MS=6000
